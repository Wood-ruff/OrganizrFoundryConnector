<div class="organizr-browser-toolbar">
  <input type="search" name="search" value="{{term}}" placeholder="{{localize "ORGANIZR.Browser.Search"}}" autocomplete="off">
  <button type="button" class="organizr-icon-button" data-action="reloadSheets"
          data-tooltip="{{localize "ORGANIZR.Browser.Reload"}}" aria-label="{{localize "ORGANIZR.Browser.Reload"}}">
    <i class="fa-solid fa-rotate"></i>
  </button>
</div>
