<div class="organizr-sheet-list">
  {{#if loading}}
    <p class="organizr-hint"><i class="fa-solid fa-spinner fa-spin"></i> {{localize "ORGANIZR.Browser.Loading"}}</p>
  {{else if errorKey}}
    <p class="organizr-error">{{localize errorKey}}</p>
  {{else if loaded}}
    {{#unless total}}
      <p class="organizr-hint">{{localize "ORGANIZR.Browser.Empty"}}</p>
    {{else}}
      {{#unless projects.length}}
        <p class="organizr-hint">{{localize "ORGANIZR.Browser.NoMatch"}}</p>
      {{/unless}}
      {{#each projects as |project|}}
        <section class="organizr-browser-project">
          <h3>
            <i class="fa-solid fa-folder"></i> {{project.projectName}} <span class="organizr-count">{{project.count}}</span>
            {{#if project.importableCount}}
              <button type="button" class="organizr-section-import" data-action="importSection" data-project-id="{{project.projectId}}"
                      data-tooltip="{{localize "ORGANIZR.Browser.ImportProject" count=project.importableCount}}" {{#if ../batchRunning}}disabled{{/if}}>
                <i class="fa-solid fa-file-import"></i> {{localize "ORGANIZR.Browser.ImportAll" count=project.importableCount}}
              </button>
            {{/if}}
          </h3>
          {{#each project.types as |group|}}
            <h4>
              {{#if group.labelKey}}{{localize group.labelKey}}{{else}}{{group.type}}{{/if}}
              {{#if group.importableCount}}
                <button type="button" class="organizr-section-import" data-action="importSection" data-project-id="{{project.projectId}}" data-type="{{group.type}}"
                        data-tooltip="{{localize "ORGANIZR.Browser.ImportGroup" count=group.importableCount}}" {{#if ../../batchRunning}}disabled{{/if}}>
                  <i class="fa-solid fa-file-import"></i> {{localize "ORGANIZR.Browser.ImportAll" count=group.importableCount}}
                </button>
              {{/if}}
            </h4>
            <ul class="organizr-sheet-rows">
              {{#each group.sheets as |sheet|}}
                <li class="organizr-sheet-row{{#if sheet.inWorld}} in-world{{/if}}">
                  {{#if sheet.imageFileId}}
                    <img class="organizr-sheet-img" alt="" data-file-id="{{sheet.imageFileId}}"{{#if sheet.imageUrl}} src="{{sheet.imageUrl}}"{{/if}}>
                  {{else}}
                    <span class="organizr-sheet-img placeholder"><i class="fa-solid fa-file-lines"></i></span>
                  {{/if}}
                  <span class="organizr-sheet-text">
                    <span class="organizr-sheet-name">{{sheet.name}}</span>
                    {{#if sheet.tags.length}}<span class="organizr-sheet-tags">{{#each sheet.tags}}<span class="organizr-tag">{{this}}</span>{{/each}}</span>{{/if}}
                  </span>
                  {{#if (ne sheet.level null)}}<span class="organizr-sheet-level">{{localize "ORGANIZR.Browser.Level" level=sheet.level}}</span>{{/if}}
                  <span class="organizr-sync-state{{#if sheet.inWorld}} in-world{{/if}}" data-tooltip="{{#if sheet.inWorld}}{{localize "ORGANIZR.Browser.InWorld"}}{{else}}{{localize "ORGANIZR.Browser.NotInWorld"}}{{/if}}">
                    <i class="fa-solid {{#if sheet.inWorld}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
                  </span>
                  {{#if sheet.importable}}
                    <button type="button" class="organizr-icon-button" data-action="importSheet" data-file-id="{{sheet.fileId}}"
                            data-tooltip="{{#if sheet.inWorld}}{{localize "ORGANIZR.Browser.Update"}}{{else}}{{localize "ORGANIZR.Browser.Import"}}{{/if}}"
                            aria-label="{{#if sheet.inWorld}}{{localize "ORGANIZR.Browser.Update"}}{{else}}{{localize "ORGANIZR.Browser.Import"}}{{/if}}"
                            {{#if sheet.importing}}disabled{{/if}}>
                      <i class="fa-solid {{#if sheet.importing}}fa-spinner fa-spin{{else if sheet.inWorld}}fa-rotate{{else}}fa-file-import{{/if}}"></i>
                    </button>
                  {{else}}
                    <span class="organizr-icon-button not-importable" data-tooltip="{{localize "ORGANIZR.Browser.NotImportable"}}"><i class="fa-solid fa-ban"></i></span>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{/each}}
        </section>
      {{/each}}
    {{/unless}}
  {{/if}}
</div>
